{
    "include": ["src", "plugins", "vite.config.ts"],
    "compilerOptions": {
        "target": "ES2023",
        "lib": ["DOM", "DOM.Iterable", "ES2023"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "types": ["vite/client"],
        "strict": true,
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "skipLibCheck": true,
        "verbatimModuleSyntax": true,
        "noUncheckedIndexedAccess": true
    }
}
